#!/bin/bash

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$CURRENT_DIR/../src/helpers.sh"

# Usage: t <optional zoxide-like dir, relative or absolute path>
# If no argument is given, a combination of existing sessions and a zoxide query will be displayed in a FZF

# Internal modes used by the fzf popup's ctrl-x binding (kill the highlighted
# session, then refresh the list in place). Not part of the public CLI.
case "$1" in
--list-sessions)
  build_session_list "$2"
  exit 0
  ;;
--kill-row)
  kill_session_from_row "$2"
  exit 0
  ;;
--preview-row)
  preview_row "$2"
  exit 0
  ;;
esac

# Parse optional argument
if [ "$*" ]; then
  # Argument is given
  eval "$(zoxide init bash)"
  RESULT=$(z "$*" && pwd)
else
  # No argument is given. Use FZF
  SELECT_WINDOW=$(get_tmux_option "@session-wizard-windows" "off")
  FZF_ARGS=(--reverse --print-query --tiebreak=index)
  FZF_ARGS+=(--bind "ctrl-x:execute-silent(\"$CURRENT_DIR/t\" --kill-row {1})+reload(\"$CURRENT_DIR/t\" --list-sessions $SELECT_WINDOW)")
  if __fzf_version_at_least 0 64; then
    FZF_ARGS+=(--footer "ctrl-x: kill session")
  fi
  if [ "$(get_tmux_option "@session-wizard-preview" "off")" == "on" ]; then
    FZF_ARGS+=(--preview "\"$CURRENT_DIR/t\" --preview-row {}")
  fi
  RESULT=$(build_session_list "$SELECT_WINDOW" |
    $(__fzfcmd) "${FZF_ARGS[@]}" | tail -n 1)
  if [ -z "$RESULT" ]; then
    exit 0
  fi
fi

# Makes sure tmux is running in order to get all the correct tmux options below
cleanup_tmp_session() {
  if [[ -n "$TMP_SESSION_NAME" ]]; then
    tmux kill-session -t "$TMP_SESSION_NAME" 2>/dev/null
    rm -rf "$TMP_SESSION_DIR"
    TMP_SESSION_NAME=""
  fi
}
if ! tmux info &>/dev/null; then
  TMP_SESSION_DIR=$(mktemp -d)
  TMP_SESSION_NAME=$(session_name --full-path "$TMP_SESSION_DIR")
  # The trap covers every exit path (missing directory, aborting hook, ...);
  # the happy path still cleans up explicitly before attaching.
  trap cleanup_tmp_session EXIT
  # Allow for custom tmux config (mostly for testing)
  if [ -n "$SESSION_WIZARD_INTEGRATION_TEST" ]; then
    tmux -f "$TMUX_CONFIG" new-session -d -s "$TMP_SESSION_NAME" -c "$TMP_SESSION_DIR"
  else
    tmux new-session -d -s "$TMP_SESSION_NAME" -c "$TMP_SESSION_DIR"
  fi

fi

log_message "Running session-wizard"

# Get or create session
if [[ $RESULT == *":"* ]]; then
  # RESULT comes from list-sessions or list-windows
  SESSION=$(echo "$RESULT" | awk '{print $1}')
  SESSION=${SESSION//:/}
  if [ "$SELECT_WINDOW" == "on" ]; then
    WINDOW=$(echo "$RESULT" | awk -F"[()]" '{print $(NF-1)}')
  fi
else
  # RESULT is a path

  DIR_FULL=$(echo "$RESULT" | sed -e "$TILDE_REPLACER")
  DIR_WITH_TILDE=$(echo "$RESULT" | sed -e "$HOME_REPLACER") # in case it came from a direct usage of `t <path>`

  # Quit if directory does not exists
  if [ ! -d "$DIR_FULL" ]; then
    exit 0
  fi

  # Promote rank in zoxide.
  zoxide add "$DIR_FULL"

  MODE=$(get_tmux_option "@session-wizard-mode" "directory")
  SESSION=$(session_name --"$MODE" "$DIR_WITH_TILDE")

  if ! SESSION=$(create_session "$SESSION" "$DIR_FULL"); then
    # pre-create-session-hook asked to abort
    exit 1
  fi
fi

# Clean up tmp session before attaching (attach can block until detach)
cleanup_tmp_session

attach_to_tmux_session "$SESSION" "$WINDOW"
